  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@types/node": "22.18.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "meshoptimizer": "0.25.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.4"
  }
